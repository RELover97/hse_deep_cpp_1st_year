
digraph G {
 graph [bgcolor="transparent",pad=0.2,ranksep=0.6,nodesep=1,fontname="DejaVu Sans",label="Окно владеет талоном, талон только знает окно",labelloc=t,fontsize=16];
 node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=13,fillcolor="#DCFCE7",color="#15803D",margin="0.25,0.20"];
 desk [label="Desk\nокно"];
 ticket [label="DeskTicket\nталон"];
 desk -> ticket [label="shared_ptr\nвладение",fontname="DejaVu Sans",fontsize=11,color="#15803D"];
 ticket -> desk [label="weak_ptr\nбез владения",fontname="DejaVu Sans",fontsize=11,color="#64748B",style=dashed];
}
